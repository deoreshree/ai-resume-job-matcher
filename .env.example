# Copy this file to .env and fill in values. Never commit .env.

# Optional OpenAI-compatible GenAI provider. The app works without a key.
OPENAI_API_KEY=
# LLM_API_KEY is accepted as an alternative to OPENAI_API_KEY.
LLM_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: override API base for OpenAI-compatible proxies
# OPENAI_BASE_URL=https://api.openai.com/v1

# Set true only after the configured sentence-transformer model has been downloaded locally.
ENABLE_EMBEDDINGS=false
