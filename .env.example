# ============================================================================
# AI Resume & Job Match Predictor - Environment Configuration
# ============================================================================
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ============================================================================
# REQUIRED VARIABLES (for specific use cases)
# ============================================================================

# Optional: OpenAI-compatible API key for enhanced resume advice
# The application works without this key using rule-based guidance only.
# OPENAI_API_KEY=sk-...
# Alternative name (if using a proxy or different provider):
# LLM_API_KEY=...

# ============================================================================
# OPTIONAL VARIABLES (with sensible defaults)
# ============================================================================

# OpenAI model selection (only used if OPENAI_API_KEY is set)
# Default: gpt-4o-mini (fast, cost-effective)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Override OpenAI API base URL for proxies or self-hosted models
# Default: https://api.openai.com/v1 (official OpenAI endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Enable sentence-transformer embeddings for richer semantic matching
# Set to true only AFTER downloading the embedding model locally
# Default: false (uses fast TF-IDF fallback instead)
# To enable:
#   1. Uncomment below and set to true
#   2. Run: python -m sentence_transformers download all-MiniLM-L6-v2
#   3. Restart the application
# ENABLE_EMBEDDINGS=false

# Optional: Change the sentence-transformer model (ignored if ENABLE_EMBEDDINGS=false)
# Default: all-MiniLM-L6-v2 (lightweight, fast)
# See: https://www.sbert.net/docs/pretrained_models.html
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Change the spaCy language model for enhanced NER (named entity recognition)
# Default: en_core_web_sm (small, lightweight)
# To use a larger model:
#   1. Run: python -m spacy download en_core_web_lg
#   2. Uncomment below and update
# SPACY_MODEL=en_core_web_sm

# ============================================================================
# DEPLOYMENT VARIABLES (set automatically by platform)
# ============================================================================

# The application reads PORT from environment for cloud deployments.
# Most platforms (Render, Heroku, Azure) set this automatically.
# Default: 5000 (local development)
# PORT is typically set by the deployment platform, not this file.

# ============================================================================
# NOTES
# ============================================================================
# 
# Core functionality:
#   - Resume parsing (PDF/DOCX) works without any keys
#   - Predefined job matching works without any keys
#   - ATS analysis works without any keys
#   - Interview question generation works without any keys
#
# Optional enhancements:
#   - OPENAI_API_KEY enables AI-written resume advice and explanations
#   - ENABLE_EMBEDDINGS enables advanced semantic matching (download model first)
#
# Security:
#   - Never commit API keys to version control
#   - Use .gitignore to protect .env
#   - Rotate keys regularly
#   - Use environment variable injection in production
#
